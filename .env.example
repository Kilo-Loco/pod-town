# Copy to .env and fill in. Every value is optional.

PORT=8080

# The address phones can reach, used for the QR code. Defaults to this machine's LAN IP.
# For a public event, put the server behind HTTPS and set this, e.g. https://podtown.example.com
PUBLIC_URL=

# Protects /admin (winners list, CSV export, manual draw). If blank, a random one is printed at startup.
ADMIN_TOKEN=

# Raffle
RAFFLE_PRIZE='$25 in Runpod Credits'
RAFFLE_WINNERS=1
# 1 = each person can only win once across the whole event
RAFFLE_ONE_WIN=1
# Hours a winner has to tap Claim
CLAIM_HOURS=24

# Prompt AI: any OpenAI-compatible chat endpoint. For a Runpod Serverless vLLM worker:
#   LLM_BASE_URL=https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
#   LLM_API_KEY=<your Runpod API key>
#   LLM_MODEL=<the model the endpoint serves>
# Leave LLM_BASE_URL blank to use built-in keyword matching.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=10000

# Speeds up every activity (30 = a 15-minute activity takes 30 seconds). Use 1 for the real event.
TIME_SCALE=1
